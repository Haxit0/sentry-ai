# Optional public frontend API origin. Leave blank for the Vite /api dev proxy.
# Never put credentials in VITE_ variables; they are bundled into the browser.
VITE_API_BASE_URL=

# Future explicit integration settings. The fixture endpoints do not read
# these settings or make external calls. Settings do not activate an adapter.
# Never commit .env or actual credentials.
ZETARIS_BASE_URL=
ZETARIS_API_TOKEN=
ZETARIS_ORG_ID=

# Meterless Nightshift, used only by POST /api/investigations and scripts/agent_smoke.py.
# See docs/METERLESS_INTEGRATION.md. Prefer METERLESS_TOKEN_FILE (Nightshift's own
# proxy-token file) over copying the token into METERLESS_API_TOKEN.
METERLESS_BASE_URL=
METERLESS_API_TOKEN=
METERLESS_TOKEN_FILE=
METERLESS_MODEL=meterless/local
METERLESS_APP=sentry-ai
# Optional: H-MEM engine state directory (default ~/.local/state/sentry-ai/hmem) and Node 22.7+ binary.
SENTRY_HMEM_DIR=
SENTRY_NODE=
